# Copier ce fichier vers .env.local et renseigner les valeurs depuis le tableau de bord Supabase
# (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé service_role Supabase — Project Settings → API → Clés secrètes. À NE JAMAIS exposer au
# navigateur (pas de préfixe NEXT_PUBLIC_) : utilisée uniquement par le webhook de paiement
# pour mettre à jour le statut d'un paiement sans session utilisateur.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Identifiants CinetPay (tableau de bord CinetPay → Intégration).
CINETPAY_API_KEY=...
CINETPAY_SITE_ID=...
